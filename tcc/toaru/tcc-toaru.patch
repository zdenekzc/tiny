diff --git a/tccgen.c b/tccgen.c
index d9721a5..8591b05 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -8682,10 +8682,23 @@ static void gen_function(Sym *sym)
     /* NOTE: we patch the symbol size later */
     put_extern_sym(sym, cur_text_section, ind, 0);
 
+#if TARGETOS_Toaru
+    /* Constructors go into ".ctors"/".dtors", the sections ToaruOS libc uses
+       (its gcc does not emit .init_array), so that libc's _libc_init and the
+       program's own constructors end up in ONE array - pre_main() runs only
+       the range between __init_array_start and __init_array_end.  Note that
+       libc.a is loaded after this unit is compiled, so _libc_init is the last
+       entry: a constructor must not need stdio. */
+    if (sym->type.ref->f.func_ctor)
+        add_array (tcc_state, ".ctors", sym->c);
+    if (sym->type.ref->f.func_dtor)
+        add_array (tcc_state, ".dtors", sym->c);
+#else
     if (sym->type.ref->f.func_ctor)
         add_array (tcc_state, ".init_array", sym->c);
     if (sym->type.ref->f.func_dtor)
         add_array (tcc_state, ".fini_array", sym->c);
+#endif
 
     /* put debug symbol */
     tcc_debug_funcstart(tcc_state, sym);
