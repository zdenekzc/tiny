+/* Default image address.  ToaruOS has no PIE; the kernel loads exactly
+   what it finds in PT_LOAD, and native ToaruOS images start at
+   0x3F000000 (linker/link.ld: ". = 0x3F000000").  At the Linux address
+   0x400000 the program SIGSEGVs in the guest before the first syscall
+   (measured on our own images, README §3b) => the target uses ToaruOS' address. */
+#if TARGETOS_Toaru
+#define ELF_START_ADDR 0x3F000000
+#else
