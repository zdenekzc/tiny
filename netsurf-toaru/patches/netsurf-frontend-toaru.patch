-# -*- mode: makefile-gmake -*-
-##
-## tool setup for the toaru target
-##
-
-ifeq ($(origin GCCSDK_INSTALL_ENV),undefined)
-  PKG_CONFIG := pkg-config
-else
-  PKG_CONFIG := PKG_CONFIG_LIBDIR="$(GCCSDK_INSTALL_ENV)/lib/pkgconfig" pkg-config                
