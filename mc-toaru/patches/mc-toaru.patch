+// Leave the command output on the terminal until F9 is pressed.  endwin()
+// has already switched back to the normal screen, so the terminal's own
+// scrollback (Shift+PgUp/PgDn or the mouse wheel) can be used to review it.
+static void wait_for_f9(void) {
+    struct termios saved, current;
+    int have_tio = tcgetattr(STDIN_FILENO, &saved) == 0;
+
+    // White on a blue background: the hint is the one thing the user must
+    // notice, and it must stand out from the program output above it.
+    printf("\n\033[0;97;44m [F9] return to mini-commander \033[0m\n");
+    fflush(stdout);
+
+    if (have_tio) {
+        current = saved;
+        current.c_lflag &= ~(unsigned)(ICANON | ECHO);
+        current.c_iflag &= ~(unsigned)(IXON | ICRNL);
+        current.c_cc[VMIN] = 1;
+        current.c_cc[VTIME] = 0;
+        tcsetattr(STDIN_FILENO, TCSANOW, &current);
+    }
+
+    // ToaruOS Terminal (and xterm) sends F9 as ESC [ 2 0 ~
+    int state = 0;
+    for (;;) {
+        unsigned char c;
+        if (read(STDIN_FILENO, &c, 1) != 1) break;
+        switch (state) {
+            case 0: state = (c == 0x1b) ? 1 : 0; break;
+            case 1: state = (c == '[') ? 2 : (c == 0x1b ? 1 : 0); break;
+            case 2: state = (c == '2') ? 3 : (c == 0x1b ? 1 : 0); break;
+            case 3: state = (c == '0') ? 4 : (c == 0x1b ? 1 : 0); break;
+            case 4:
+                if (c == '~') goto done;
+                state = (c == 0x1b) ? 1 : 0;
+                break;
+        }
+    }
+done:
+    if (have_tio) tcsetattr(STDIN_FILENO, TCSANOW, &saved);
+    fflush(stdout);
+}
+
 
